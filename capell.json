{
    "manifest-version": 3,
    "name": "capell-app/address",
    "slug": "address",
    "displayName": "Address",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "shipped",
    "description": "One list of countries and postal addresses in your admin, so each site's address is typed once and kept in step.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\Address",
    "surfaces": ["admin"],
    "dependencies": {
        "requires": ["capell-app/admin", "capell-app/core"],
        "supports": [
            "capell-app/bookings",
            "capell-app/events",
            "capell-app/privacy-center"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\Address\\Providers\\AddressServiceProvider",
            "Capell\\Address\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": ["Capell\\Address\\Providers\\ConsoleServiceProvider"],
        "runtime": ["Capell\\Address\\Providers\\AddressServiceProvider"],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\Address\\Manifest\\AddressResourceContribution",
            "resourceClass": "Capell\\Address\\Filament\\Resources\\Addresses\\AddressResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\Address\\Manifest\\CountryResourceContribution",
            "resourceClass": "Capell\\Address\\Filament\\Resources\\Countries\\CountryResource"
        },
        {
            "type": "configurator",
            "class": "Capell\\Address\\Manifest\\AddressConfiguratorsContribution",
            "configuratorClasses": [
                "Capell\\Address\\Filament\\Configurators\\Addresses\\DefaultAddressConfigurator",
                "Capell\\Address\\Filament\\Configurators\\Countries\\DefaultCountryConfigurator",
                "Capell\\Address\\Filament\\Configurators\\Languages\\DefaultLanguageConfigurator"
            ],
            "groups": ["Addresses", "Countries", "Language"]
        },
        {
            "type": "schema-extender",
            "class": "Capell\\Address\\Manifest\\AddressSiteSchemaExtenderContribution",
            "extenderClass": "Capell\\Address\\Filament\\Resources\\Sites\\Schemas\\Extenders\\SiteSchemaExtender",
            "tag": "Site"
        },
        {
            "type": "model",
            "class": "Capell\\Address\\Manifest\\AddressModelsContribution",
            "modelClasses": [
                "Capell\\Address\\Models\\Address",
                "Capell\\Address\\Models\\Country"
            ]
        },
        {
            "type": "asset",
            "class": "Capell\\Address\\Manifest\\AddressAdminAssetsContribution",
            "surface": "admin",
            "assets": ["capell-address", "blade-country-flags"]
        },
        {
            "type": "migration",
            "class": "Capell\\Address\\Manifest\\AddressMigrationsContribution",
            "tables": ["countries", "addresses"],
            "migrationFiles": [
                "2026_05_10_190839_01_create_countries_table",
                "2026_05_10_190839_02_create_addresses_table",
                "2026_07_12_000001_add_address_ownership_and_encrypt_meta"
            ]
        },
        {
            "type": "console-command",
            "class": "Capell\\Address\\Manifest\\AddressConsoleCommandsContribution",
            "commands": [
                "capell:address-countries-import",
                "capell:address-geocode-normalize",
                "capell:address-blind-index-rehash",
                "capell:address-install",
                "capell:address-faker",
                "capell:address-demo"
            ],
            "commandClasses": [
                "Capell\\Address\\Console\\Commands\\ImportCountriesCommand",
                "Capell\\Address\\Console\\Commands\\NormalizeAddressGeocodingCommand",
                "Capell\\Address\\Console\\Commands\\RehashAddressBlindIndexesCommand",
                "Capell\\Address\\Console\\Commands\\InstallCommand",
                "Capell\\Address\\Console\\Commands\\FakerCommand",
                "Capell\\Address\\Console\\Commands\\DemoCommand"
            ]
        },
        {
            "type": "health-check",
            "class": "Capell\\Address\\Health\\AddressHealthCheck"
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["countries", "addresses"]
    },
    "commands": {
        "install": "capell:address-install",
        "setup": null,
        "demo": "capell:address-demo",
        "demoParams": ["sites"],
        "doctor": null,
        "countriesImport": "capell:address-countries-import",
        "geocodeNormalize": "capell:address-geocode-normalize",
        "blindIndexRehash": "capell:address-blind-index-rehash",
        "faker": "capell:address-faker"
    },
    "actions": {
        "install": "Capell\\Address\\Actions\\InstallAddressPackageAction"
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["address", "address-admin"],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\Address\\Models\\Address::$city",
                "Capell\\Address\\Models\\Address::$line1",
                "Capell\\Address\\Models\\Address::$line2",
                "Capell\\Address\\Models\\Address::$meta",
                "Capell\\Address\\Models\\Address::$name",
                "Capell\\Address\\Models\\Address::$postal_code",
                "Capell\\Address\\Models\\Address::$state"
            ],
            "hashedTokenFields": [
                "addresses.line1_hash",
                "addresses.postal_code_hash"
            ],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\Address\\Actions\\BuildGeocodingHttpClientAction"
            ]
        },
        "adminSurface": {
            "authorization": "policies",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "address.package-health",
            "label": "Address package surfaces, providers, and install health are discoverable by Diagnostics.",
            "class": "Capell\\Address\\Health\\AddressHealthCheck",
            "severity": "critical",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Type each address once and pick it for your sites, with a country list you upload and check first.",
        "description": "Several sites in one admin often end up with the same address typed differently. Here you keep postal addresses and countries in a single list, and each site picks its own from its settings. Nothing new shows on your public pages. A health check points out two addresses that look like one place spelled two ways. If two sites share an office and one moves, editing it from that site's settings gives that site a copy of its own. You load countries from a CSV file of names with two- and three-letter codes, and you see what would be added or switched off before anything is saved.",
        "problem": "The same office address gets typed into several places and drifts out of step.",
        "outcome": "Each site picks its address from one list, and likely duplicates are flagged for you.",
        "faq": [
            {
                "question": "Does it add anything to my public pages, such as a map or postcode lookup?",
                "answer": "No. Addresses and countries are managed in the admin only. Nothing is added to your public pages, and there is no postcode lookup or map."
            },
            {
                "question": "Do I have to set up a list of countries before I add addresses?",
                "answer": "Capell has no built-in list, so you add the countries you need. Upload them as a CSV file and check what the upload would add or switch off before it is saved, or add one at a time with New country (advanced)."
            },
            {
                "question": "If two sites share an address and one moves, does the other site's address change?",
                "answer": "No. Edit the address from the moving site's settings and that site gets its own copy to change. The other site keeps the original."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Address card showing an empty Countries screen in light and dark themes above steps labelled Country, Address and Reuse.",
                "caption": "The card describes the idea in three steps, a country, an address and then reusing it."
            },
            {
                "path": "docs/screenshots/countries-admin-index.png",
                "alt": "Countries list with United Kingdom marked Default, plus United States, France and Germany with ISO codes and active status.",
                "caption": "Load countries from a CSV with Import countries, or add one by hand with New country (advanced)."
            },
            {
                "path": "docs/screenshots/countries-admin-index-dark.png",
                "alt": "Dark theme Countries list with four active countries, ISO codes, and Import countries and New country buttons.",
                "caption": "The country list as it looks in the dark admin theme."
            },
            {
                "path": "docs/screenshots/addresses-admin-index.png",
                "alt": "Addresses list with a London studio marked Default, a New York office and a Paris showroom, each with city and country.",
                "caption": "One list of postal addresses that your sites can pick from, with a New address button."
            },
            {
                "path": "docs/screenshots/addresses-admin-index-dark.png",
                "alt": "Dark theme Addresses list with three addresses and a Countries button beside New address.",
                "caption": "The address list as it looks in the dark admin theme."
            }
        ],
        "categories": ["admin", "foundation"]
    },
    "contributionTraceability": {
        "deferredContributions": []
    }
}
