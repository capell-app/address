        "admin": [],
        "frontend": []
    },
    "contributes": [],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": "capell:address-demo",
        "demoParams": ["sites"],
        "doctor": null
    },
    "actions": {
        "install": "Capell\\Address\\Actions\\InstallAddressPackageAction"
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["address", "address-admin"],
    "performance": {
        "frontendRenderBudgetMs": 0,
        "adminQueryBudget": 40,
        "cacheTags": [],
